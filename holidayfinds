    .badge-label {
      font-family: 'Montserrat', sans-serif;
      font-size: 14px;
      font-weight: 800;
      color: #F3D99B !important;
      margin-bottom: 12px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      text-align: center;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      padding: 10px 24px;
      border-radius: 30px;
      background: rgba(18, 22, 31, 0.85);
      border: 1px solid var(--card-border);
      color: #F3D99B !important;
      font-size: 15px;
      font-weight: 700;
      font-family: 'Montserrat', sans-serif;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4), 0 0 20px rgba(223, 186, 103, 0.15);
      text-decoration: none;
      width: 100%;
      transition: all 0.3s ease;
    }

    .badge:hover {
      border-color: var(--card-border-glow);
      box-shadow: 0 0 25px rgba(223, 186, 103, 0.6), inset 0 0 10px rgba(255, 255, 255, 0.4);
    }

    .badge-icon {
      width: 24px;
      height: 24px;
      object-fit: contain;
    }

    footer {
      padding: 40px 0;
      border-top: 1px solid var(--card-border);
      text-align: center;
      color: var(--text-muted);
      font-size: 14px;
    }

    footer a {
      color: var(--text-gold);
      text-decoration: underline;
    }

    .footer-compliance {
      font-size: 11px;
      color: rgba(255, 255, 255, 0.7);
      margin-top: 10px;
      line-height: 1.4;
    }

    @media (max-width: 768px) {
      header { padding: 30px 0 20px; gap: 18px; }
      .svg-logo-banner { max-height: 70px; }
      .cart-card { padding: 28px 20px; }
      .bundle-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
