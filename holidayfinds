    .bundle-sub {
      font-size: 13px;
      color: var(--text-muted);
      margin-bottom: 16px;
    }

    .bundle-item-list {
      list-style: none;
      padding: 0;
      margin: 0 0 20px 0;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .bundle-item {
      font-size: 13px;
      color: var(--text-main);
      padding-bottom: 8px;
      border-bottom: 1px dashed rgba(223, 186, 103, 0.15);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .bundle-item span {
      font-weight: 600;
      color: var(--text-gold);
      font-size: 11px;
    }

    .btn-copy-bundle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      padding: 12px 20px;
      border-radius: 30px;
      background: var(--amazon-gold-gradient);
      color: #000000;
      font-size: 14px;
      font-weight: 800;
      font-family: 'Montserrat', sans-serif;
      text-decoration: none;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4), 0 0 20px rgba(223, 186, 103, 0.2);
      transition: all 0.2s ease;
    }

    .btn-copy-bundle:hover {
      border-color: #ffffff;
      box-shadow: 0 0 25px rgba(223, 186, 103, 0.75), inset 0 0 10px rgba(255, 255, 255, 0.4);
      transform: translateY(-2px);
    }

    .cta-group {
      display: flex;
      justify-content: center;
      align-items: stretch;
      gap: 20px;
      flex-wrap: wrap;
      max-width: 800px;
      margin: 0 auto;
    }

    .badge-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 20px 24px;
      background: var(--card-bg);
      backdrop-filter: blur(16px);
      border: 1px solid var(--card-border);
      border-radius: var(--radius-lg);
      position: relative;
      overflow: hidden;
      transition: transform 0.2s ease, border-color 0.3s ease, box-shadow 0.3s ease;
      width: 100%;
      max-width: 380px;
    }

    .badge-card:hover {
      border-color: var(--card-border-glow);
      box-shadow: 0 12px 35px rgba(0, 0, 0, 0.6), 0 0 30px rgba(223, 186, 103, 0.35);
