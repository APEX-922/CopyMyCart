  <style>
    :root {
      --bg-dark: #080A0F;
      --card-bg: rgba(18, 22, 31, 0.85);
      --card-border: rgba(223, 186, 103, 0.25);
      --card-border-glow: rgba(223, 186, 103, 0.9);
      --text-main: #ffffff;
      --text-muted: rgba(255, 255, 255, 0.7);
      --text-gold: #F3D99B;
      --gold-gradient: linear-gradient(135deg, #F9E4B7 0%, #DFBA67 50%, #9E7D3B 100%);
      --gold-solid: #DFBA67;
      --ebay-blue-gradient: linear-gradient(135deg, #0064D2 0%, #0046BE 100%);
      --ebay-blue-solid: #0064D2;
      --amazon-gold-gradient: linear-gradient(135deg, #FBE3B5 0%, #E2C374 50%, #B89648 100%);
      --radius-lg: 12px;
      --radius-md: 8px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    body {
      background-color: var(--bg-dark);
      background-image: 
        radial-gradient(circle at 50% 0%, rgba(223, 186, 103, 0.15) 0%, transparent 65%),
        radial-gradient(circle at 80% 90%, rgba(158, 125, 59, 0.1) 0%, transparent 50%);
      color: var(--text-main);
      line-height: 1.6;
      overflow-x: hidden;
      position: relative;
      min-height: 100vh;
    }

    .parallax-bg {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 550px;
      height: 550px;
      background-image: url('https://raw.githubusercontent.com/APEX-922/CopyMyCart/main/icon.png');
      background-repeat: no-repeat;
      background-position: center;
      background-size: contain;
      opacity: 0.15;
      pointer-events: none;
      z-index: 0;
      filter: drop-shadow(0 0 35px rgba(223, 186, 103, 0.25));
      transition: opacity 0.3s ease, filter 0.3s ease;
    }

    .glitter-container {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      overflow: hidden;
      z-index: 1;
    }

    .sparkle {
      position: absolute;
      width: 4px;
      height: 4px;
      background: #F9E4B7;
      border-radius: 50%;
      box-shadow: 0 0 8px #DFBA67, 0 0 12px #F9E4B7;
      animation: sparkleFly 3s infinite ease-in-out;
      opacity: 0;
      will-change: transform, opacity;
    }

    @keyframes sparkleFly {
      0% { transform: translateY(10px) scale(0.3); opacity: 0; }
      50% { opacity: 0.8; }
      100% { transform: translateY(-40px) scale(1.1); opacity: 0; }
    }

    .container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 24px;
      position: relative;
      z-index: 2;
    }

    header {
      padding: 40px 0 28px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      border-bottom: 1px solid var(--card-border);
      background: rgba(10, 13, 20, 0.85);
      backdrop-filter: blur(12px);
      gap: 24px;
    }

    .logo {
      display: flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      position: relative;
      width: 100%;
      max-width: 650px;
      cursor: pointer;
    }

    .svg-logo-banner {
      width: 100%;
      height: auto;
      max-height: 95px;
      overflow: visible;
      filter: drop-shadow(0 0 25px rgba(223, 186, 103, 0.6)) brightness(1.15) !important;
      forced-color-adjust: none !important;
      color-scheme: only dark !important;
      transition: transform 0.3s ease, filter 0.3s ease;
    }

    .svg-logo-banner text {
      fill: #F3D99B !important;
      color: #F3D99B !important;
      forced-color-adjust: none !important;
    }

    .logo:hover .svg-logo-banner {
      transform: scale(1.03);
      filter: drop-shadow(0 0 35px rgba(223, 186, 103, 0.85)) brightness(1.25) !important;
    }

    .nav-links {
      display: flex;
      gap: 12px;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
    }

    .nav-link {
      padding: 10px 22px;
      border-radius: 20px;
      background: rgba(18, 22, 31, 0.6);
      border: 1px solid var(--card-border);
      color: var(--text-gold);
      text-decoration: none;
      font-size: 14px;
      font-weight: 600;
      font-family: 'Montserrat', sans-serif;
      transition: transform 0.2s ease, background 0.3s ease, color 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
      display: inline-block;
      cursor: pointer;
    }

    .nav-link:hover, .nav-link.active {
      background: var(--gold-gradient);
      color: #080A0F;
      border-color: var(--card-border-glow);
      box-shadow: 0 0 25px rgba(223, 186, 103, 0.6), inset 0 0 10px rgba(255, 255, 255, 0.4);
    }

    .main-content {
      padding: 50px 0 60px;
    }

    .cart-card {
      background: var(--card-bg);
      backdrop-filter: blur(16px);
      border: 1px solid var(--card-border);
      border-radius: var(--radius-lg);
      padding: 40px;
      max-width: 900px;
      margin: 0 auto 40px auto;
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.45);
      transition: transform 0.2s ease, border-color 0.3s ease, box-shadow 0.3s ease;
      position: relative;
      overflow: hidden;
    }

    .cart-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      background: radial-gradient(circle 250px at var(--mouse-x, -500px) var(--mouse-y, -500px), rgba(223, 186, 103, 0.15), transparent 80%);
      pointer-events: none;
      transition: opacity 0.3s ease;
    }

    .cart-card:hover {
      border-color: var(--card-border-glow);
      box-shadow: 0 12px 35px rgba(0, 0, 0, 0.6), 0 0 30px rgba(223, 186, 103, 0.35);
    }

    .subtitle {
      font-size: 20px;
      color: var(--text-gold);
      text-align: center;
      font-weight: 800;
      font-family: 'Montserrat', sans-serif;
      margin-bottom: 8px;
      letter-spacing: 0.3px;
    }

    .season-description {
      font-size: 14px;
      color: var(--text-muted);
      text-align: center;
      margin-bottom: 30px;
    }

    .bundle-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
      gap: 24px;
    }

    .bundle-card {
      background: rgba(8, 10, 15, 0.75);
      border: 1px solid var(--card-border);
      border-radius: var(--radius-md);
      padding: 24px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
