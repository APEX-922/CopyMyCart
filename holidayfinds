              { id: "B09X222222", title: "Glow in the Dark Party Cups (50 Pack)", isAmazon: true }
            ]
          }
        ]
      },
      holidays: {
        title: "🎄 Black Friday & Holiday Wishlist Bundles",
        description: "Top-rated gift sets, home tech, and festive decorations.",
        bundles: [
          {
            title: "Smart Home Holiday Lighting",
            sub: "Automate your tree and outdoor light display.",
            items: [
              { id: "B08Y111111", title: "Outdoor Smart Outlets (2-Pack)", isAmazon: true },
              { id: "B08Y222222", title: "RGB LED Smart Light Strip 100ft", isAmazon: true }
            ]
          },
          {
            title: "Tech Stocking Stuffers",
            sub: "Must-have gadgets for everyone on your list.",
            items: [
              { id: "B0BP9SNVH9", title: "Fire TV Stick 4K", isAmazon: true },
              { id: "B0932QJ2JZ", title: "Apple AirTag (4-Pack)", isAmazon: true }
            ]
          }
        ]
      },
      general: {
        title: "⚡ Trending Everyday Deal Bundles",
        description: "Popular multi-item carts for daily savings on Amazon and eBay.",
        bundles: [
          {
            title: "Everyday Tech & Desk Setup",
            sub: "High-speed charging and cable organization.",
            items: [
              { id: "B08T654321", title: "Anker USB-C Fast Charger 65W", isAmazon: true },
              { id: "B08T987654", title: "Braided Charging Cables (3-Pack)", isAmazon: true }
            ]
          },
          {
            title: "Skincare Essentials Kit",
            sub: "Top-rated cleansers and hydrating treatments.",
            items: [
              { id: "B01MSSDEPK", title: "CeraVe Hydrating Facial Cleanser", isAmazon: true },
              { id: "B00PBX3L7K", title: "COSRX Snail Mucin Power Essence", isAmazon: true }
            ]
          }
        ]
      }
    };

    function getSeasonKey() {
      const month = new Date().getMonth() + 1; // 1 to 12
      if (month === 10) return "halloween";
      if (month === 11 || month === 12) return "holidays";
      return "general";
    }

    function buildShareUrl(items) {
      const paramParts = items.map(i => `${i.id}:${encodeURIComponent(i.title)}`);
      return `https://apex-922.github.io/CopyMyCart/share?items=${paramParts.join(',')}`;
    }

    function renderPage() {
      const seasonKey = getSeasonKey();
      const season = SEASONAL_DATA[seasonKey] || SEASONAL_DATA.general;

      document.getElementById("season-title").textContent = season.title;
      document.getElementById("season-description").textContent = season.description;

      const grid = document.getElementById("bundle-grid");
      grid.innerHTML = "";

      season.bundles.forEach(bundle => {
        const card = document.createElement("div");
        card.className = "bundle-card";

        const shareUrl = buildShareUrl(bundle.items);

        card.innerHTML = `
          <div>
            <h3 class="bundle-title">${bundle.title}</h3>
            <p class="bundle-sub">${bundle.sub}</p>
            <ul class="bundle-item-list">
              ${bundle.items.map(item => `
                <li class="bundle-item">
                  ${item.title}
                  <span>${item.isAmazon ? 'Amazon' : 'eBay'}</span>
                </li>
              `).join('')}
            </ul>
          </div>
          <a href="${shareUrl}" target="_blank" rel="noopener noreferrer" class="btn-copy-bundle">
            🛒 Copy Bundle (${bundle.items.length} Items)
          </a>
        `;

        grid.appendChild(card);
      });
    }

    function createGlitter(containerId, count = 14) {
      const container = document.getElementById(containerId);
      if (!container) return;

      for (let i = 0; i < count; i++) {
        const sparkle = document.createElement('div');
        sparkle.className = 'sparkle';
        sparkle.style.left = `${Math.random() * 100}%`;
        sparkle.style.top = `${Math.random() * 100}%`;
        sparkle.style.animationDelay = `${Math.random() * 3}s`;
        sparkle.style.animationDuration = `${2 + Math.random() * 2}s`;
        container.appendChild(sparkle);
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      createGlitter('logoGlitter', 14);
      createGlitter('badgeGlitterChrome', 4);
      createGlitter('badgeGlitterFirefox', 4);

      renderPage();

      const centerLogo = document.getElementById('bgLogoCenter');
      if (centerLogo) {
        document.addEventListener('mousemove', (e) => {
          const centerRect = centerLogo.getBoundingClientRect();
          const centerDist = Math.hypot(
            e.clientX - (centerRect.left + centerRect.width / 2),
            e.clientY - (centerRect.top + centerRect.height / 2)
          );
          const threshold = 380;

          if (centerDist < threshold) {
            const intensity = 1 - (centerDist / threshold);
            centerLogo.style.opacity = (0.15 + (intensity * 0.6)).toString();
            centerLogo.style.filter = `drop-shadow(0 0 ${35 + intensity * 40}px rgba(223, 186, 103, ${0.3 + intensity * 0.7})) brightness(${1 + intensity * 0.25})`;
          } else {
            centerLogo.style.opacity = '0.15';
            centerLogo.style.filter = 'drop-shadow(0 0 35px rgba(223, 186, 103, 0.25)) brightness(1)';
          }
        });
      }

      document.querySelectorAll('.magnetic-target, .nav-link, .cart-card, .badge-card').forEach(btn => {
        btn.addEventListener('mousemove', (e) => {
          const rect = btn.getBoundingClientRect();
          const x = e.clientX - rect.left - rect.width / 2;
          const y = e.clientY - rect.top - rect.height / 2;

          if (btn.classList.contains('nav-link')) {
            btn.style.transform = `translate(${x * 0.2}px, ${y * 0.2}px)`;
          }

          btn.style.setProperty('--mouse-x', `${e.clientX - rect.left}px`);
          btn.style.setProperty('--mouse-y', `${e.clientY - rect.top}px`);
        });

        btn.addEventListener('mouseleave', () => {
          btn.style.transform = 'translate(0px, 0px)';
        });
      });
    });
  </script>
</body>
</html>
