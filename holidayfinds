  <script>
    // AFFILIATE CONFIGURATION
    const EPN_CAMPAIGN_ID = "5339209459";
    const EPN_ROTATION_ID = "711-53200-19255-0";
    const AMAZON_ASSOCIATE_TAG = "apex0225-20";

    // SEASONAL DATA DATABASE
    const SEASONAL_DATA = {
      halloween: {
        title: "🎃 Spooky Season & Halloween Bundles",
        description: "Hand-curated Halloween decor, party kits, and costume accessories ready to share.",
        bundles: [
          {
